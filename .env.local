# Ambiente local. Valores de desenvolvimento, seguros para versionar; nunca reutilize na AWS.
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-apiserver:8080/execution/
# Todos os componentes precisam do mesmo segredo para assinar os tokens entre si.
AIRFLOW__API_AUTH__JWT_SECRET=local-dev-jwt-secret
AIRFLOW__API__SECRET_KEY=local-dev-secret-key
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true

# Login da UI (criado pelo airflow-init)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Conexão usada na validação da gold
AIRFLOW_CONN_TRINO_DEFAULT=trino://airflow@trino:8080/

# Onde e como a DAG executa os containers (ver dags/bigdata_pipeline/config.py)
BIGDATA_DOCKER_URL=tcp://docker-proxy:2375
BIGDATA_DOCKER_NETWORK=bigdata
BIGDATA_INGESTION_IMAGE=bigdata-ingestion:local
BIGDATA_DBT_IMAGE=bigdata-dbt:local
# Fontes da imagem de ingestão (`ingestion list`), separadas por vírgula.
# Cada uma vira a cadeia independente ingest_<fonte> → register_<fonte>.
BIGDATA_INGESTION_SOURCES=open_meteo,open_meteo_locations
# Subconjunto lido pelo dbt: só essas fontes bloqueiam o dbt_build.
BIGDATA_DBT_SOURCES=open_meteo,open_meteo_locations
# Alerta de falha por e-mail: vazio desliga o envio. O ambiente local não envia e-mail;
# fora dele, o padrão é andredimov@hotmail.com (dags/bigdata_pipeline/config.py).
BIGDATA_ALERT_EMAILS=
